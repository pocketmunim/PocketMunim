{
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "functions": {
    "app/main.py": {
      "maxDuration": 90
    }
  },
  "crons": [
    {
      "path": "/api/crons/daily-digest",
      "schedule": "30 7 * * *"
    }
  ]
}